GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ELEVENLABS_API_KEY=
PORT=3001
# Local Postgres. Setup: brew install postgresql@16 && brew services start postgresql@16 && npm run db:reset
DATABASE_URL=postgres://localhost:5432/lockin
COURSE_TZ=America/New_York
# Set to 1 to run on the in-memory store instead of Postgres (fallback if Postgres misbehaves).
USE_MEMORY=
# Optional no-database persistent store. Relative to the backend's working directory.
# Set on the ONE host server; takes precedence over Postgres and USE_MEMORY.
# Keep this private folder outside client/public. Never commit real lecture data.
SHARED_DATA_DIR=
# Set to 1 for a small demo (default). Use 3 for the existing small-group privacy gate.
MIN_STUDENTS=1
